# ==========================================
# Starknet / BitcoinPro Support Desk Email
# ==========================================
# Email shown on the client-side support widget
NEXT_PUBLIC_SUPPORT_EMAIL=support@starknet-portal.io

# Email address where support inquiries are routed to
SUPPORT_RECEIVER_EMAIL=support@starknet-portal.io

# (Optional) Direct SMTP settings (Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ==========================================
# Email Delivery Configuration (EmailJS)
# ==========================================
# EmailJS (https://dashboard.emailjs.com)
EMAILJS_SERVICE_ID=service_qcwhmbh
EMAILJS_TEMPLATE_ID=template_cmike7r
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# ==========================================
# Admin Telegram Login & Support Notifications
# ==========================================
# Telegram Bot (https://t.me/BotFather -> Create Bot -> Get token)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id